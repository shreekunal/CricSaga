<?xml version="1.0" encoding="utf-8"?>
<!--
    CricSaga — Barlow Condensed Downloadable Font Family
    Used exclusively for: score display numerals, key stats (runs, wickets, overs)
    Weights defined: Regular (400), Bold (700), ExtraBold (800)
    Provider: Google Fonts via Play Services (zero APK size cost)
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    android:fontProviderAuthority="com.google.android.gms.fonts"
    android:fontProviderPackage="com.google.android.gms"
    android:fontProviderQuery="Barlow Condensed"
    android:fontProviderCerts="@array/com_google_android_gms_fonts_certs">

    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/barlow_condensed" />

    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/barlow_condensed" />

    <font
        android:fontStyle="normal"
        android:fontWeight="800"
        android:font="@font/barlow_condensed" />

</font-family>
